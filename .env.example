# "policy" = offline rule-based traders (no key). "llm" = real LLM agents with tool calling.
AGORA_BRAIN=policy

# Any OpenAI-compatible endpoint with tool calling (OpenAI, Groq, OpenRouter, Together, vLLM, Ollama)
AGORA_LLM_BASE_URL=
AGORA_LLM_API_KEY=sk-...
AGORA_LLM_MODEL=gpt-4.1-mini
AGORA_RESEARCHER_MODEL=gpt-4.1-nano

# memory = MCP servers in-process; stdio = every MCP server in its own OS process
AGORA_TRANSPORT=memory
AGORA_SEED=7
AGORA_STARTING_CASH=100000

# Risk policy, enforced by the accounts MCP server
AGORA_MAX_POSITION_PCT=0.30
AGORA_MAX_ORDER_PCT=0.25
AGORA_MAX_TRADES_PER_CYCLE=6
AGORA_COMMISSION_BPS=5
AGORA_SPREAD_BPS=10
